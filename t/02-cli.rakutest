use Test;
use Tubular::CodeGolf::Evaluator;

# CLI's only job is dispatch: map each subcommand to the right Evaluator.run call.
# The pipeline itself is covered by t/05 and t/06, so here we mock Evaluator.run
# (capture its arguments, don't execute it) and assert what the CLI asks for.
my @run-calls;
Tubular::CodeGolf::Evaluator.^lookup('run').wrap(my method (|c) { @run-calls.push: c });

# Minimal stdout sink for the one command that prints directly (single-threaded).
class OutputCapture {
    has $.captured = '';
    method print($s) { $!captured ~= $s }
    method say($s)   { $!captured ~= $s ~ "\n" }
    method flush()   {}
}

# Import MAIN inside a block so it doesn't land in the mainline (which would
# make Rakudo auto-run MAIN at program end with the test's args).
{
    use Tubular::CodeGolf::CLI;

    subtest 'compile prints "ok" without touching the Evaluator', {
        plan 2;
        @run-calls = ();
        my $cap = OutputCapture.new;
        { my $*OUT = $cap; MAIN('compile'); }
        is $cap.captured.chomp, 'ok', 'outputs "ok"';
        is @run-calls.elems, 0, 'never runs the pipeline';
    };

    subtest 'evaluate runs the default (CSV) pipeline over everything', {
        plan 3;
        @run-calls = ();
        MAIN('evaluate');
        is @run-calls.elems, 1, 'Evaluator.run called once';
        nok @run-calls[0].hash<task>:exists,   'no task scoping (whole tree)';
        nok @run-calls[0].hash<format>:exists, 'no format override (defaults to CSV)';
    };

    subtest 'release <tag> renders Markdown scoped to that competition', {
        plan 3;
        @run-calls = ();
        MAIN('release', '000-hello');
        is @run-calls.elems, 1, 'Evaluator.run called once';
        is @run-calls[0].hash<task>,   '000-hello', 'scoped to the tag/competition folder';
        is @run-calls[0].hash<format>, 'md',        'Markdown output';
    };
}

done-testing;
