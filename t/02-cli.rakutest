use Test;

plan 3;

# Get path to project root from test directory
my $test-dir = $?FILE.IO.parent;
my $project-root = $test-dir.parent;

# Output capture class for testing
class OutputCapture {
    has $.captured = '';
    method print($s) { $!captured ~= $s }
    method say($s) { $!captured ~= $s ~ "\n" }
    method flush() { }
}

subtest 'CLI module can be loaded', {
    plan 1;

    lives-ok { require Tubular::CodeGolf::CLI }, 'CLI module loads without error';
};

subtest 'CLI compile command via MAIN', {
    plan 2;

    use Tubular::CodeGolf::CLI;

    my $capture = OutputCapture.new;
    my $*OUT = $capture;

    lives-ok { MAIN('compile') }, 'compile command executes without error';
    is $capture.captured.chomp, 'ok', 'compile command outputs "ok"';
};

subtest 'CLI evaluate command', {
    plan 2;

    # Run as a subprocess and capture its stdout via a pipe. In-process $*OUT
    # capture is unreliable: the evaluator emits results from throttle worker
    # threads (see SolutionExecutor), where a dynamic $*OUT override doesn't apply.
    my %env = %*ENV, CODEGOLF_PATH => $project-root.add('t/data').Str;
    my $proc = run
        $*EXECUTABLE, '-I', $project-root.add('lib').Str,
        $project-root.add('bin').add('code-golf').Str, 'evaluate',
        :out, :err, :%env;
    my $out = $proc.out.slurp(:close);
    $proc.err.slurp(:close);

    is $proc.exitcode, 0, 'evaluate command exits cleanly';
    ok $out.contains('success'), 'evaluate command produces result output';
};

done-testing;
